# Solo desarrollo local. Cambia estos valores en tu archivo .env.
API_PORT=4000
DB_PASSWORD=pawly-local-change-me
MYSQL_ROOT_PASSWORD=pawly-root-local-change-me
JWT_SECRET=pawly-local-jwt-change-me-use-a-long-random-value

# IDs de usuarios autorizados a gestionar catálogos (separados por coma).
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GRAPHQL_INTROSPECTION=false

# Servicios locales del Segundo Parcial. Sustituir por claves propias.
MONGO_ROOT_PASSWORD=pawly-mongo-root-change-me
MONGO_PASSWORD=pawly-mongo-change-me
REDIS_PASSWORD=pawly-redis-change-me
NEO4J_PASSWORD=pawly-neo4j-change-me
HISTORY_CACHE_TTL=60
SESSION_TTL=3600

# Cambia solo estos puertos si ya tienes otros contenedores de clase.
MONGO_PORT=27017
REDIS_PORT=6379
REDISINSIGHT_PORT=8001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
